<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only certificates from the system's own trusted authorities: certificates a user or
     another app has added to the tablet are not trusted, so they can't be used to intercept downloads. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
